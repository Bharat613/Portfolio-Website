# Copy this file to ".env" and fill in your own EmailJS values.
# See README.md -> "Contact form" for step-by-step setup (takes ~5 minutes).

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# YouTube Data API v3 (use a browser-restricted key in production)
VITE_YOUTUBE_API_KEY=
VITE_YOUTUBE_CHANNEL_ID=
# Watch hours are not available from the public Data API; add your Analytics value manually.
VITE_YOUTUBE_WATCH_HOURS=

# GitHub lifetime contributions are not available from the public REST API.
VITE_GITHUB_TOTAL_CONTRIBUTIONS=
